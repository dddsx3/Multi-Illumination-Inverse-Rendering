# ============================================
# Multi-Illumination Inverse Rendering
# 入库原则：代码 + 文档 + 指标证据(json/csv/图) 入库；
#          训练日志 / checkpoint / 运行时状态 / 冒烟产物 仅存本地
# ============================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
.venv_a10
.venv_a10/
.venv_cpu/
env/
precompute/

# Model checkpoints / weights（大文件不入库）
*.pth
*.pt
*.ckpt
checkpoints/

# TensorBoard / 训练日志目录
logs/
events.out.tfevents.*
health_reports/
diagnosis_output/
diagnostics_report.*
visualizations/

# 运行日志（_ 前缀 txt = 本地运行证据，审计时按需拷贝）
_*.txt
_*.log

# 编排器运行时状态（run_arms.py / run_phase2_all.py 生成）
progress.json
arms_progress.json
arms_plan.json
_arms_bench.json

# 冒烟产物（D12 物理隔离，禁止入库与进对比矩阵）
_SMOKE_/
_SMOKE_*
smoke_artifacts/
_smoke_models/
archive/

# 本地实验归档（不入库）

# 数据（大文件不入库）
processed_data/
data/
datasets/

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
nul

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Archives
*.zip
*.7z
*.rar
*.tar
*.gz

# Blender / 渲染中间产物
*.blend
*.blend1
obj_models/

# 资产下载清单（download_objaverse.py 运行时生成）
models_list.txt
obj_models_list.txt
